# LOUSA backend production environment. Real Redis/payment adapter required.
APP_ENV=production
NODE_ENV=production
API_HOST=0.0.0.0
PORT=10000
PUBLIC_API_URL=https://REPLACE_WITH_PRODUCTION_API.example
DATABASE_URL=postgresql://REPLACE_ME
MIGRATION_DATABASE_URL=postgresql://REPLACE_ME
REDIS_URL=rediss://REPLACE_ME
REQUIRE_REDIS=true
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=lousa-moon
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lousa-moon","private_key":"REPLACE_ME","client_email":"REPLACE_ME"}
ALLOW_FIREBASE_REST_FALLBACK=false
PAYMENT_PROVIDER=REPLACE_WITH_REAL_PROVIDER
PAYMENT_SECRET_KEY=REPLACE_ME
PAYMENT_WEBHOOK_SECRET=REPLACE_ME
EMAIL_PROVIDER=REPLACE_WITH_REAL_PROVIDER
EMAIL_FROM="LOUSA MOON <REPLACE_WITH_VERIFIED_SENDER>"
SMS_PROVIDER=REPLACE_WITH_REAL_PROVIDER
ALLOW_DEV_OTP_RESPONSE=false
# Temporary one-time owner setup only. Set in Render, use once, then delete both variables and redeploy.
# ADMIN_BOOTSTRAP_ENABLED=true
# ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
# Emergency one-time owner password recovery only. Set in Render, use once, then delete both and redeploy.
# ADMIN_OWNER_RECOVERY_ENABLED=true
# ADMIN_OWNER_RECOVERY_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_SECRET
