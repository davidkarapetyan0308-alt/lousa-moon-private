# LOUSA MOON Android QA build — public/non-secret values only.
# Copy to .env.qa only if you prefer a file over inline environment variables.

EXPO_PUBLIC_APP_MODE=api
EXPO_PUBLIC_AUTH_PROVIDER=firebase
EXPO_PUBLIC_BUILD_CHANNEL=qa
EXPO_PUBLIC_RELEASE_BUILD=false

# Public online backend embedded in the standalone APK.
EXPO_PUBLIC_LOUSA_API_URL=https://lousa-moon-api.onrender.com
PUBLIC_API_URL=https://lousa-moon-api.onrender.com

# Firebase project/client metadata is read from google-services.json.
FIREBASE_PROJECT_ID=lousa-moon
GOOGLE_SERVICES_JSON_PATH=./google-services.json

# Required only for email verification/password-reset actions when enabled.
EXPO_PUBLIC_FIREBASE_AUTH_ACTION_URL=

# Public map configuration. OpenFreeMap is the no-key fallback.
EXPO_PUBLIC_LOUSA_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_DISABLE_PUBLIC_MAP_FALLBACK=false
EXPO_PUBLIC_ROUTE_FALLBACK_URL=
EXPO_PUBLIC_LOUSA_EVENTS_URL=

# Optional Android Maps key. Do not commit restricted private/server keys here.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_MAPTILER_API_KEY=

# QA APK signing (the keystore file itself must stay outside the source ZIP).
# The SHA-1/SHA-256 of this exact key must be registered for com.lousa.moon.qa.
LOUSA_QA_KEYSTORE_PATH=/absolute/path/to/lousa-qa.keystore
LOUSA_QA_KEY_ALIAS=androiddebugkey
LOUSA_QA_KEYSTORE_PASSWORD=CHANGE_ME
LOUSA_QA_KEY_PASSWORD=CHANGE_ME
