# LOUSA MOON Android production build — copy to .env.production and fill required values.
# Never commit private keystores, Firebase service-account JSON, database credentials, or payment secrets.

EXPO_PUBLIC_APP_MODE=api
EXPO_PUBLIC_AUTH_PROVIDER=firebase
EXPO_PUBLIC_BUILD_CHANNEL=production
EXPO_PUBLIC_RELEASE_BUILD=true

# Public online backend embedded in the standalone APK.
EXPO_PUBLIC_LOUSA_API_URL=https://lousa-moon-api.onrender.com
PUBLIC_API_URL=https://lousa-moon-api.onrender.com

# Firebase Android clients for both packages are stored in google-services.json.
FIREBASE_PROJECT_ID=lousa-moon
GOOGLE_SERVICES_JSON_PATH=./google-services.json

# REQUIRED for production email verification/password reset. Use an authorized HTTPS URL.
EXPO_PUBLIC_FIREBASE_AUTH_ACTION_URL=https://REPLACE_WITH_AUTHORIZED_DOMAIN.example/lousa

# Public map configuration.
EXPO_PUBLIC_LOUSA_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_DISABLE_PUBLIC_MAP_FALLBACK=false
EXPO_PUBLIC_ROUTE_FALLBACK_URL=
EXPO_PUBLIC_LOUSA_EVENTS_URL=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_MAPTILER_API_KEY=

# Backend deployment variables (server only; not embedded in the APK).
APP_ENV=production
NODE_ENV=production
API_HOST=0.0.0.0
PORT=10000
CORS_ORIGINS=https://REPLACE_WITH_ADMIN_DOMAIN.example
DATABASE_URL=postgresql://REPLACE_ME
MIGRATION_DATABASE_URL=postgresql://REPLACE_ME
REDIS_URL=rediss://REPLACE_ME
REQUIRE_REDIS=true
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
AUTH_PROVIDER=firebase
ALLOW_FIREBASE_REST_FALLBACK=false
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lousa-moon","private_key":"REPLACE_ME","client_email":"REPLACE_ME"}
EMAIL_PROVIDER=console
EMAIL_FROM="LOUSA MOON <onboarding@resend.dev>"
SMS_PROVIDER=console
MAPTILER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
PAYMENT_PROVIDER=REPLACE_WITH_REAL_PROVIDER
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
DELIVERY_ZONE_BASE_FEE_MINOR=0
DELIVERY_ZONE_RADIUS_KM=15
ALLOW_DEV_OTP_RESPONSE=false
