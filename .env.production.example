# Public API runtime
APP_ENV=production
NODE_ENV=production
API_HOST=0.0.0.0
PORT=8080
PUBLIC_API_URL=https://YOUR-SERVICE.koyeb.app
CORS_ORIGINS=https://YOUR-ADMIN-DOMAIN.example

# Supabase PostgreSQL. Prefer the transaction pooler URL for the running API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Use the Supabase session pooler (port 5432) for Prisma migrations.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Upstash Redis TLS URL. Keep the rediss:// scheme.
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REQUIRE_REDIS=true

# Generate independent values with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET

# Firebase Admin. Paste the entire service-account JSON as one secret value in the host dashboard.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=lousa-moon
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lousa-moon","private_key":"REPLACE_ME","client_email":"REPLACE_ME"}

# Email can remain disabled until a verified provider is connected.
EMAIL_PROVIDER=console
EMAIL_FROM=LOUSA MOON <onboarding@resend.dev>
SMS_PROVIDER=console

# Map API is optional because the mobile app has an OpenFreeMap fallback.
MAPTILER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

PAYMENT_PROVIDER=sandbox
DELIVERY_ZONE_BASE_FEE_MINOR=0
DELIVERY_ZONE_RADIUS_KM=15
ALLOW_DEV_OTP_RESPONSE=false
