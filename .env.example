# Mobile build mode
EXPO_PUBLIC_APP_MODE=api
EXPO_PUBLIC_AUTH_PROVIDER=firebase
EXPO_PUBLIC_BUILD_CHANNEL=qa
EXPO_PUBLIC_RELEASE_BUILD=false

# QA phone build: use your Mac LAN IP, never localhost.
EXPO_PUBLIC_LOUSA_API_URL=http://192.168.1.100:4100

# Required for production release; use an authorized HTTPS domain in Firebase Auth.
EXPO_PUBLIC_FIREBASE_AUTH_ACTION_URL=https://auth.example.com/lousa

# Maps
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
MAPTILER_API_KEY=
EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_LOUSA_MAP_STYLE_URL=
# Optional public no-key fallback. LOUSA defaults to the official OpenFreeMap Positron style.
EXPO_PUBLIC_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_DISABLE_PUBLIC_MAP_FALLBACK=false

# Backend network
API_HOST=0.0.0.0
PORT=4100
APP_ENV=development
PUBLIC_API_URL=http://192.168.1.100:4100

# Backend Firebase Admin. Keep credentials only in local/server .env, never in the app or committed ZIP.
FIREBASE_PROJECT_ID=lousa-moon
# Local QA fallback only. Production must use Firebase Admin credentials below.
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Backend production services
DATABASE_URL=postgresql://lousa:lousa@localhost:5432/lousa_moon?schema=public
REDIS_URL=
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
EMAIL_PROVIDER=console
EMAIL_FROM="LOUSA MOON <onboarding@resend.dev>"
ALLOW_DEV_OTP_RESPONSE=false
RESEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=console

# Delivery truth: delivery is included in every LOUSA plan. Keep the legacy zone fee at zero.
DELIVERY_ZONE_BASE_FEE_MINOR=0
DELIVERY_ZONE_RADIUS_KM=15
